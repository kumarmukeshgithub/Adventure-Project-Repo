{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"workspaceName": {
			"type": "string",
			"metadata": "Workspace name",
			"defaultValue": "mukesh-awproject-synapse"
		},
		"mukesh-awproject-synapse-WorkspaceDefaultSqlServer_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'mukesh-awproject-synapse-WorkspaceDefaultSqlServer'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=tcp:mukesh-awproject-synapse.sql.azuresynapse.net,1433;Initial Catalog=@{linkedService().DBName}"
		},
		"mukesh-awproject-synapse-WorkspaceDefaultStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mukeshsynapse.dfs.core.windows.net"
		}
	},
	"variables": {
		"workspaceId": "[concat('Microsoft.Synapse/workspaces/', parameters('workspaceName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('workspaceName'), '/mukesh-awproject-synapse-WorkspaceDefaultSqlServer')]",
			"type": "Microsoft.Synapse/workspaces/linkedServices",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"parameters": {
					"DBName": {
						"type": "String"
					}
				},
				"annotations": [],
				"type": "AzureSqlDW",
				"typeProperties": {
					"connectionString": "[parameters('mukesh-awproject-synapse-WorkspaceDefaultSqlServer_connectionString')]"
				},
				"connectVia": {
					"referenceName": "AutoResolveIntegrationRuntime",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/integrationRuntimes/AutoResolveIntegrationRuntime')]"
			]
		},
		{
			"name": "[concat(parameters('workspaceName'), '/mukesh-awproject-synapse-WorkspaceDefaultStorage')]",
			"type": "Microsoft.Synapse/workspaces/linkedServices",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('mukesh-awproject-synapse-WorkspaceDefaultStorage_properties_typeProperties_url')]"
				},
				"connectVia": {
					"referenceName": "AutoResolveIntegrationRuntime",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/integrationRuntimes/AutoResolveIntegrationRuntime')]"
			]
		},
		{
			"name": "[concat(parameters('workspaceName'), '/AutoResolveIntegrationRuntime')]",
			"type": "Microsoft.Synapse/workspaces/integrationRuntimes",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"type": "Managed",
				"typeProperties": {
					"computeProperties": {
						"location": "AutoResolve",
						"dataFlowProperties": {
							"computeType": "General",
							"coreCount": 8,
							"timeToLive": 0
						}
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/Create Schema')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE SCHEMA gold;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "awdatabase",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/Create View Gold')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "\n\n-- CREATE VIEW CALENDAR\n\n\nCREATE VIEW gold.calendar\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Calendar/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n-- CREATE VIEW Customers\n\n\nCREATE VIEW gold.customers\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Customers/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n\n\n\n-- CREATE VIEW Products\n\n\nCREATE VIEW gold.products\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Products/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n-- CREATE VIEW Returns\n\n\nCREATE VIEW gold.returns\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Returns/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n\n\n-- CREATE VIEW Sales\n\n\nCREATE VIEW gold.sales\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Sales/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n-- CREATE VIEW Subcategories\n\n\nCREATE VIEW gold.subcategories\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Subcategories/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n\n-- CREATE VIEW Territories\n\n\nCREATE VIEW gold.territories\nAS\nSELECT\n    *\n    FROM\n        OPENROWSET(\n            BULK 'https://adventureprojectstorage.blob.core.windows.net/silverlayer/AdventureWorks_Territories/',\n            FORMAT = 'PARQUET'\n        ) as QUER1\n\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "awdatabase",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/SQL script 1')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "awdatabase",
						"poolName": "Built-in"
					}
				}
			},
			"dependsOn": []
		}
	]
}